<section class="section-trend">
    <div class="container">
        <div class="text-center header">
            <h2>유입 변화 시뮬레이션</h2>
        </div>

        <div class="chart-container">
            <div class="bars">
                <!-- Month 1 -->
                <div class="bar-group">
                    <div class="bar" style="height: 30%;">
                        <span class="tooltip">초기 세팅 및 노출 시작</span>
                    </div>
                    <span class="label">1개월 후</span>
                </div>

                <!-- Month 2 -->
                <div class="bar-group">
                    <div class="bar" style="height: 45%;">
                        <span class="tooltip">검색 유입 증가</span>
                    </div>
                    <span class="label">2개월 후</span>
                </div>

                <!-- Month 3 -->
                <div class="bar-group">
                    <div class="bar highlight" style="height: 75%;">
                        <span class="tooltip">바이럴 확산 & 방문 급증</span>
                    </div>
                    <span class="label">3개월 후</span>
                </div>

                <!-- Month 4 -->
                <div class="bar-group">
                    <div class="bar highlight" style="height: 90%;">
                        <span class="tooltip">안정적 매출 궤도 진입</span>
                    </div>
                    <span class="label">4개월 후</span>
                </div>
            </div>

            <!-- Y-axis line -->
            <div class="y-axis"></div>
            <!-- X-axis line -->
            <div class="x-axis"></div>
        </div>

        <p class="disclaimer text-center">
            ※ 시뮬레이션 예시이며 실제 결과는 매장/지역/시즌에 따라 달라질 수
            있습니다.
        </p>
    </div>
</section>

<style>
    .section-trend {
        background-color: white;
        padding-bottom: 40px;
    }

    .header {
        margin-bottom: 3rem;
    }

    h2 {
        font-size: 2rem;
        font-weight: 700;
    }

    .chart-container {
        max-width: 600px;
        height: 300px;
        margin: 0 auto 3rem;
        position: relative;
        padding-left: 40px; /* Space for Y-axis visual */
        padding-bottom: 30px; /* Space for X-axis labels */
        display: flex;
        align-items: flex-end;
    }

    .y-axis {
        position: absolute;
        left: 40px;
        top: 0;
        bottom: 30px;
        width: 1px;
        background: #ddd;
    }

    .x-axis {
        position: absolute;
        left: 40px;
        right: 0;
        bottom: 30px;
        height: 1px;
        background: #ddd;
    }

    .bars {
        display: flex;
        justify-content: space-around;
        width: 100%;
        height: 100%;
        align-items: flex-end;
        z-index: 1;
    }

    .bar-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 15%;
        height: 100%;
        justify-content: flex-end;
        position: relative;
    }

    .bar {
        width: 100%;
        background: #e0e0e0;
        border-radius: 6px 6px 0 0;
        transition: height 1s ease-out;
        position: relative;
        cursor: pointer;
    }

    .bar.highlight {
        background: var(--color-accent);
        box-shadow: 0 0 15px rgba(255, 192, 0, 0.4);
    }

    .bar:hover .tooltip {
        opacity: 1;
        transform: translateX(-50%) translateY(-10px);
    }

    .tooltip {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(0);
        background: rgba(0, 0, 0, 0.8);
        color: white;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: all 0.2s ease;
        z-index: 10;
    }

    .tooltip::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: rgba(0, 0, 0, 0.8) transparent transparent transparent;
    }

    .label {
        margin-top: 15px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-text-sub);
    }

    .disclaimer {
        font-size: 0.85rem;
        color: #999;
    }

    @media (max-width: 480px) {
        .chart-container {
            height: 250px;
        }
        .label {
            font-size: 0.8rem;
        }
    }
</style>
