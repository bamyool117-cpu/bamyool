---

---

<section id="hero" class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-content">
        <div class="stats-group fade-in-up">
            <div class="stat-line">
                경주 한 해 외국인 관광객 <br class="mobile-only" />
                <span class="num-highlight big">117만 명</span>
            </div>
            <div class="stat-line sub">
                그중 <span class="percent">35%</span>,
            </div>
            <div class="stat-line">
                약 <span class="num-highlight big">41만 명</span>은 <br
                    class="mobile-only"
                />
                <span class="text-white">중국인 관광객</span>
            </div>

            <p class="footnote">
                ※ 출처: 한국관광공사 데이터랩 · 경주시 공개 통계
            </p>
        </div>

        <div class="cta-group fade-in-up delay-2">
            <a
                href="https://pf.kakao.com/_dixchX"
                target="_blank"
                class="btn btn-kakao"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    viewBox="0 0 16 16"
                    style="margin-right:8px;"
                >
                    <path
                        d="M8 1.918c-4.418 0-8 2.973-8 6.643 0 2.21 1.309 4.183 3.33 5.377-.123.957-.463 3.344-.486 3.497-.024.16.06.26.176.22 1.432-.976 3.868-2.613 4.14-2.81 7.933.266 8.529-6.284.84-6.284zm0 0"
                    ></path>
                </svg>
                카카오톡으로 상담하기
            </a>
            <a href="tel:010-5534-1170" class="btn btn-phone">
                전화 상담: <span class="num-text">010-5534-1170</span>
            </a>
        </div>

        <div class="connector-wrapper fade-in delay-3">
            <p class="connector-text">이들은 이렇게 가게를 찾습니다</p>
            <div class="scroll-indicator">
                <svg
                    class="arrow-down"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M7 13L12 18L17 13M7 6L12 11L17 6"></path>
                </svg>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        background-color: var(--color-bg-dark);
        color: var(--color-text-white);
        padding-top: 60px;
        text-align: center;
        overflow: hidden;
    }

    .hero-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* Darker, calmer gradient */
        background: radial-gradient(
            circle at 50% 40%,
            #1a0505 0%,
            #000000 100%
        );
        opacity: 0.9;
        z-index: 1;
    }

    .hero-content {
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        height: 100%;
        width: 100%;
        /* Ensure content stretches to fill height for margin-top: auto to work */
        min-height: 100vh;
        padding: 2rem 0; /* Add some padding container */
    }

    /* Typography for Stats */
    .stats-group {
        margin-bottom: 3rem;
        margin-top: auto; /* Center stats vertically with cta */
    }

    .stat-line {
        font-size: 1.8rem;
        font-weight: 400; /* Regular weight for calm tone */
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 1.2rem;
        word-break: keep-all;
        line-height: 1.3;
    }

    .stat-line.sub {
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        font-size: 1.5rem;
    }

    .num-highlight {
        font-weight: 800;
        color: var(--color-accent);
        letter-spacing: -0.02em;
    }

    .num-highlight.big {
        font-size: 3.8rem;
        display: inline-block;
        vertical-align: middle;
        line-height: 1;
        margin-left: 10px;
    }

    .percent {
        font-weight: 700;
        color: #fff;
        font-size: 1.8rem;
    }

    .text-white {
        color: #fff;
        font-weight: 600;
    }

    .footnote {
        margin-top: 4rem;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.3);
        font-weight: 300;
    }

    /* CTA Group */
    .cta-group {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 4rem;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.05rem;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
    }

    .btn:hover {
        transform: translateY(-3px);
    }

    .btn-kakao {
        background-color: #fee500;
        color: #191919;
    }

    .btn-phone {
        background-color: transparent;
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #ffffff;
    }
    .btn-phone:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: #ffffff;
    }

    .num-text {
        margin-left: 6px;
        letter-spacing: 0.02em;
    }

    /* Connector & Scroll */
    .connector-wrapper {
        margin-top: auto;
        padding-bottom: 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
        opacity: 0.6;
        animation: bounce 2s infinite;
    }

    .connector-text {
        font-size: 1rem;
        font-weight: 400;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 0.5rem;
    }

    @keyframes bounce {
        0%,
        20%,
        50%,
        80%,
        100% {
            transform: translateY(0);
        }
        40% {
            transform: translateY(-10px);
        }
        60% {
            transform: translateY(-5px);
        }
    }

    .fade-in-up {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
    .delay-2 {
        animation-delay: 0.4s;
    }
    .delay-3 {
        animation-delay: 1.4s;
    }

    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .mobile-only {
        display: none;
    }

    @media (max-width: 768px) {
        .mobile-only {
            display: block;
        }

        .stat-line {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 1.2rem;
        }
        .stat-line.sub {
            font-size: 1.1rem;
        }

        .num-highlight.big {
            font-size: 3.2rem;
            margin-left: 0;
            margin-top: 0.5rem;
        }
        .percent {
            font-size: 1.4rem;
        }

        .btn {
            padding: 0.9rem 1.5rem;
            width: 100%;
        }
        .cta-group {
            width: 100%;
            flex-direction: column;
            gap: 0.8rem;
            padding: 0 20px 4rem 20px; /* added padding check */
        }

        .connector-wrapper {
            /* ensure it moves down */
        }

        .connector-text {
            font-size: 0.9rem;
        }
    }
</style>
